{
  "info": {
    "name": "Expense Limiter API Tests",
    "description": "Test workflow for expense limiter functionality with JWT authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": "client123"
    },
    {
      "key": "jwtToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login successful\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token received\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "1. Set Limit - Goods",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 500,\n  \"category\": \"goods\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/limits",
          "host": ["{{baseUrl}}"],
          "path": ["api", "limits"]
        }
      }
    },
    {
      "name": "2. Set Limit - Services",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 300,\n  \"category\": \"services\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/limits",
          "host": ["{{baseUrl}}"],
          "path": ["api", "limits"]
        }
      }
    },
    {
      "name": "3. Transaction Under Limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 200,\n  \"category\": \"goods\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transaction processed successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Limit not exceeded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.limitExceeded).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Transaction Exceeds Limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 400,\n  \"category\": \"goods\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transaction processed successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Limit exceeded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.limitExceeded).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Services Transaction Under Limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 150,\n  \"category\": \"services\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transaction processed successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Limit not exceeded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.limitExceeded).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Services Transaction Exceeds Limit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 200,\n  \"category\": \"services\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transaction processed successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Limit exceeded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.limitExceeded).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Get Exceeded Transactions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/transactions/exceeded/{{clientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions", "exceeded", "{{clientId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response is successful\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Has exceeded transactions\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Default Limit Test (No Limit Set)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"newclient\",\n  \"amount\": 1500,\n  \"category\": \"goods\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "transactions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Transaction processed successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Default limit exceeded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.limitExceeded).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Test Unauthorized Access",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Unauthorized access blocked\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 100,\n  \"category\": \"goods\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/limits",
          "host": ["{{baseUrl}}"],
          "path": ["api", "limits"]
        }
      }
    }
  ]
}